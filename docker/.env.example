# Copy to .env before running docker compose.
# Keep this file free of real credentials. Values below are development-safe
# placeholders and must be replaced for a real deployment.

APP_IMAGE=adp-business-gateway:local
POSTGRES_IMAGE=postgres:17
NGINX_IMAGE=nginx:1.27-alpine
SERVER_HTTP_PORT=8000

PGSQL_HOST=postgres
PGSQL_PORT=5432
PGSQL_DB=adp_chat
PGSQL_USER=adp_chat
PGSQL_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-openssl-rand-base64-64
CUSTOMER_ACCOUNT_SECRET_KEY=replace-with-another-long-random-key

# Keep third-party integrations disabled until their credentials and contracts
# have been approved. The worker will not silently use a mock in production.
M3_USE_MOCK=false
M3_BASE_URL=
M3_TIMEOUT_SECONDS=10
ADP_TOOL_SERVICE_TOKEN=
PLATFORM_CHANNEL_SERVICE_TOKEN=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_CHANNEL_CREDENTIAL_KEY=
PLATFORM_CHANNEL_CREDENTIAL_KEY_VERSION=v1
PLATFORM_CHANNEL_CREDENTIAL_KEY_RING='{}'

# Optional legacy administrator debugger only. Business apps use Admin DB settings.
TC_SECRET_APPID=
TC_SECRET_ID=
TC_SECRET_KEY=
ADP_SECRET_ID=
ADP_SECRET_KEY=
APP_CONFIGS='[]'

SERVICE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
IFRAME_ORIGINS=
LOG_LEVEL=INFO
