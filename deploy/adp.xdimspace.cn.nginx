server {
    listen 80;
    listen [::]:80;
    server_name adp.xdimspace.cn;

    return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name adp.xdimspace.cn;

    ssl_certificate /etc/letsencrypt/live/adp.xdimspace.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adp.xdimspace.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / {
        proxy_pass http://127.0.0.1:18080/static/app/index;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        proxy_pass http://127.0.0.1:18080/static/app/assets/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /favicon.png {
        proxy_pass http://127.0.0.1:18080/static/app/favicon.png;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
